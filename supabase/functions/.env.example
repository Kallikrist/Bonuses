# Copy to supabase/functions/.env for local `supabase functions serve`.
# Production: set these as project secrets, not Flutter --dart-define values.
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_... --project-ref hkpkznslzkgnijoahggn
#   supabase secrets set KLING_SECRET_KEY=sk_test_... --project-ref hkpkznslzkgnijoahggn
#   supabase secrets set KLING_WEBHOOK_SECRET=... --project-ref hkpkznslzkgnijoahggn
# Kling API key must be test-mode. Never sk_live_. Never invent a real key.
# Webhook signing secret comes from Kling Developers → Webhooks (config.secret).
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
KLING_SECRET_KEY=sk_test_your_kling_secret_key_here
KLING_WEBHOOK_SECRET=your_kling_webhook_signing_secret_here
