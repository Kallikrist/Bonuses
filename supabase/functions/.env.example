# Copy to supabase/functions/.env for local `supabase functions serve`.
# Production: set this as a project secret, not a Flutter --dart-define.
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_... --project-ref hkpkznslzkgnijoahggn
# Deploy with JWT verification on (see supabase/config.toml verify_jwt = true):
#   supabase functions deploy stripe-secret --project-ref hkpkznslzkgnijoahggn
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
